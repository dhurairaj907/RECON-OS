# ============================================================
# RECON OS — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ============================================================

# --- Razorpay Test Mode Credentials ---
# SINGLE, PLATFORM-WIDE credential set — not per-organization. Every
# organization in this deployment shares the one connected Razorpay account
# (see apps/api/database.py::resolve_connected_merchant). RECON OS has no
# per-organization encrypted credential store today; a production
# multi-merchant deployment (each organization connecting its own Razorpay
# account) needs one before that's safe to build.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# --- Phase 3 (ACT): Razorpay outbound (Payment Links) ---
# TEST MODE ONLY. When false, action execution is refused (no accidental live
# transactions). Key id must be rzp_test_*. Credentials are server-side only —
# never NEXT_PUBLIC_*, never in a response / log / DB row. Missing credentials
# do NOT crash the app: action execution returns RAZORPAY_NOT_CONFIGURED.
RAZORPAY_TEST_MODE=true
RAZORPAY_TIMEOUT_SECONDS=10

# Inbound webhooks are REJECTED unless they carry a valid HMAC-SHA256 signature
# verified against RAZORPAY_WEBHOOK_SECRET (set it to the secret you register in
# the Razorpay dashboard). Set the flag below true ONLY for local dev with no
# webhook secret — it accepts unsigned webhooks and must never be used elsewhere.
RAZORPAY_ALLOW_UNSIGNED_WEBHOOKS=false

# The second of the three Phase-8 automation flags (see INTELLIGENCE_ENABLED
# above). When true, a fresh, Policy-APPROVED analysis automatically calls
# the SAME get_or_create_action()/execute_action() functions a manual
# "execute" click uses — execute_action() still independently re-validates
# policy fresh before ever calling Razorpay. NEEDS_APPROVAL/REJECTED are
# never auto-chained.
AUTOMATIC_ACTION_EXECUTION_ENABLED=false

# The simulator is a demo helper, NOT part of the real recovery path. Off by
# default. When true, every record/audit entry it creates is marked simulated=true
# and its "recovered" revenue is excluded from real metrics.
RECON_SIMULATOR_ENABLED=false

# --- Database ---
DATABASE_URL=postgresql://recon:recon_secret@localhost:5432/reconos

# --- Application ---
LOG_LEVEL=INFO
# JSON array of allowed browser origins (this is the ONLY supported format —
# pydantic-settings parses a List[str] field from env as JSON, not a
# comma-separated string). Session auth is a credentialed cookie
# (allow_credentials=True in main.py), so a wildcard "*" origin is never
# usable here regardless — browsers reject wildcard-origin + credentials.
# DEV DEFAULT (below): only the local frontend can call this API.
# PRODUCTION: set this to your real deployed frontend origin(s) BEFORE going
# live, e.g. CORS_ORIGINS=["https://app.yourdomain.com"] — leaving the
# localhost default in a public deployment means the real frontend's
# requests will be silently rejected by the browser (CORS is enforced
# client-side; non-browser/server-to-server callers are unaffected).
CORS_ORIGINS=["http://localhost:3000"]
DEFAULT_MERCHANT_NAME=RECON Demo Merchant

# --- Phase 2 (THINK): Intelligence pipeline ---
# When true, a new recovery case is analysed automatically after the Phase 1
# transaction commits (isolated transaction). The manual analyze endpoint
# (POST /api/v1/recovery-cases/{id}/intelligence:analyze) works either way.
# This is one of THREE flags — together with AUTOMATIC_ACTION_EXECUTION_ENABLED
# (Phase 3, below) and AUTOMATIC_COMMUNICATIONS_ENABLED (Phase 7, below) —
# that turn on the fully-automatic DETECT -> RECOVER -> VERIFY chain for real
# webhook-driven events (Phase 8). NEEDS_APPROVAL/REJECTED/UNKNOWN cases stay
# human-gated regardless of these flags.
INTELLIGENCE_ENABLED=false

# Policy Engine constants (deterministic, authoritative)
POLICY_MAX_RECOVERY_ATTEMPTS=3
POLICY_CONTACT_WINDOW_HOURS=24
POLICY_MAX_CONTACTS_PER_WINDOW=1
POLICY_AUTO_APPROVAL_AMOUNT_LIMIT=5000

# --- Phase 2.5 (REAL AI): optional LLM-assisted diagnosis ---
# The system is fully functional with LLM_ENABLED=false (deterministic core is
# the baseline AND the fallback). An LLM only assists diagnosis / explanation —
# never prediction, policy, financial authorisation, or Razorpay.
# Secrets are server-side ONLY. NEVER use NEXT_PUBLIC_GEMINI_API_KEY.
LLM_ENABLED=false
LLM_PROVIDER=          # set to "gemini" or "nvidia_nim" to enable
LLM_API_KEY=           # generic fallback key
LLM_MODEL=             # generic fallback model
LLM_TIMEOUT_SECONDS=8

# Gemini provider (used when LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# NVIDIA NIM provider (used when LLM_PROVIDER=nvidia_nim) — works against
# either NVIDIA's hosted API catalog (the default base URL below) or a
# self-hosted NIM container (point NVIDIA_NIM_BASE_URL at it instead). No
# default model is set: pick one from the NIM catalog you actually intend to
# use and set it explicitly.
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Phase 4 (PROVE): minimal protection for financial action endpoints ---
# Empty by default (open, for local dev/demo). Set a real shared secret
# before exposing the API beyond localhost.
RECON_API_KEY=
RECON_RATE_LIMIT_PER_MINUTE=30

# --- Phase 5: Identity + RBAC ---
DEFAULT_ORGANIZATION_NAME=RECON Demo Organization
SESSION_EXPIRY_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=30
# Controls the session cookie's `Secure` attribute (in addition to the
# always-on `HttpOnly`, never weakened by this setting).
# DEV DEFAULT (false): required for plain HTTP localhost — browsers refuse
#   to ever send a Secure cookie back over an insecure (non-HTTPS)
#   connection, so `true` here would silently break login on local HTTP dev.
# PRODUCTION (MUST be true): any deployment reachable over the public
#   internet MUST be served over HTTPS and MUST set this to true — otherwise
#   the session cookie is transmitted in plaintext and can be intercepted.
#   Never deploy publicly with this left at false.
SESSION_COOKIE_SECURE=false

# Controls the session cookie's `SameSite` attribute.
# DEV DEFAULT (lax): correct for local same-site development.
# SAME-SITE PRODUCTION (frontend + backend on the same domain, or proxied
#   to appear so): leave at "lax".
# CROSS-SITE PRODUCTION (e.g. a Cloudflare Pages frontend calling a
#   separate Render backend domain — RECON OS's target cloud architecture):
#   set to "none". Browsers refuse to send Lax/Strict cookies on a
#   cross-site fetch()/XHR at all — leaving this at "lax" across two
#   different domains means every authenticated API call silently fails
#   with 401 even though login appeared to succeed. "none" REQUIRES Secure
#   (enforced automatically regardless of SESSION_COOKIE_SECURE above —
#   browsers drop an insecure SameSite=None cookie outright).
SESSION_COOKIE_SAMESITE=lax
# Local-dev-only deterministic login — never enable in production. Creates
# ONE real user with a properly hashed password; still has to log in normally.
RECON_DEV_SEED_ADMIN=false
RECON_DEV_ADMIN_EMAIL=admin@recon.test
RECON_DEV_ADMIN_PASSWORD=

# --- Phase 5: Recovery Communications ---
# "fake" (default — safe for dev/test, never claims real delivery) or "real".
RECON_COMMUNICATIONS_MODE=fake
COMMUNICATION_RATE_LIMIT_PER_CASE_PER_DAY=5
# Real email — stdlib smtplib, no SDK dependency.
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_SSL=false          # true for implicit-TLS providers (commonly port 465)
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
# Real SMS/WhatsApp — generic HTTP webhook (no vendor SDK in this phase).
SMS_PROVIDER_WEBHOOK_URL=
SMS_PROVIDER_API_KEY=
WHATSAPP_PROVIDER_WEBHOOK_URL=
WHATSAPP_PROVIDER_API_KEY=
# Most real WhatsApp Business API providers require a pre-approved template
# name instead of freeform text. "MESSAGE_TYPE=template_name,..." — e.g.
# PAYMENT_LINK_CREATED=payment_link_v1,RECOVERY_REMINDER=reminder_v1
WHATSAPP_REQUIRE_TEMPLATE=true
WHATSAPP_TEMPLATE_IDS=

# --- Phase 7: controlled automatic recovery communication ---
# The third of the three Phase-8 automation flags (see INTELLIGENCE_ENABLED
# above). RECON never contacts a customer automatically unless this is
# explicitly enabled. Every automatic send still goes through the same
# Policy Engine / approval / opt-out / contact-availability checks a manual
# send uses.
AUTOMATIC_COMMUNICATIONS_ENABLED=false
MAX_COMMUNICATIONS_PER_CASE=10
MAX_COMMUNICATIONS_PER_CUSTOMER_PER_DAY=5
MIN_HOURS_BETWEEN_MESSAGES=12

# --- Phase 7: provider delivery-status webhooks ---
# POST /api/v1/webhooks/communications/delivery — rejected unless signed
# (HMAC-SHA256, X-RECON-Comm-Signature header) unless explicitly opted into
# unsigned acceptance for local dev.
COMMUNICATION_WEBHOOK_SECRET=
COMMUNICATION_ALLOW_UNSIGNED_WEBHOOKS=false
# POST /api/v1/webhooks/communications/brevo — Brevo's own transactional
# webhook shape, authenticated via a static Bearer token configured in
# Brevo's dashboard (developers.brevo.com/docs/secured-webhooks), NOT the
# HMAC secret above. Always fail-closed — no unsigned opt-out.
BREVO_WEBHOOK_TOKEN=

# --- Phase 7: password reset ---
# Used only to build the reset link embedded in the reset email.
FRONTEND_BASE_URL=http://localhost:3000
PASSWORD_RESET_RATE_LIMIT_PER_HOUR=5

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
