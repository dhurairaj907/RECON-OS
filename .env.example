# ============================================================
# RECON OS — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ============================================================

# --- Razorpay Test Mode Credentials ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# --- Phase 3 (ACT): Razorpay outbound (Payment Links) ---
# TEST MODE ONLY. When false, action execution is refused (no accidental live
# transactions). Key id must be rzp_test_*. Credentials are server-side only —
# never NEXT_PUBLIC_*, never in a response / log / DB row. Missing credentials
# do NOT crash the app: action execution returns RAZORPAY_NOT_CONFIGURED.
RAZORPAY_TEST_MODE=true
RAZORPAY_TIMEOUT_SECONDS=10

# Inbound webhooks are REJECTED unless they carry a valid HMAC-SHA256 signature
# verified against RAZORPAY_WEBHOOK_SECRET (set it to the secret you register in
# the Razorpay dashboard). Set the flag below true ONLY for local dev with no
# webhook secret — it accepts unsigned webhooks and must never be used elsewhere.
RAZORPAY_ALLOW_UNSIGNED_WEBHOOKS=false

# The simulator is a demo helper, NOT part of the real recovery path. Off by
# default. When true, every record/audit entry it creates is marked simulated=true
# and its "recovered" revenue is excluded from real metrics.
RECON_SIMULATOR_ENABLED=false

# --- Database ---
DATABASE_URL=postgresql://recon:recon_secret@localhost:5432/reconos

# --- Application ---
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]
DEFAULT_MERCHANT_NAME=RECON Demo Merchant

# --- Phase 2 (THINK): Intelligence pipeline ---
# When true, a new recovery case is analysed automatically after the Phase 1
# transaction commits (isolated transaction). The manual analyze endpoint
# (POST /api/v1/recovery-cases/{id}/intelligence:analyze) works either way.
INTELLIGENCE_ENABLED=false

# Policy Engine constants (deterministic, authoritative)
POLICY_MAX_RECOVERY_ATTEMPTS=3
POLICY_CONTACT_WINDOW_HOURS=24
POLICY_MAX_CONTACTS_PER_WINDOW=1
POLICY_AUTO_APPROVAL_AMOUNT_LIMIT=5000

# --- Phase 2.5 (REAL AI): optional LLM-assisted diagnosis ---
# The system is fully functional with LLM_ENABLED=false (deterministic core is
# the baseline AND the fallback). An LLM only assists diagnosis / explanation —
# never prediction, policy, financial authorisation, or Razorpay.
# Secrets are server-side ONLY. NEVER use NEXT_PUBLIC_GEMINI_API_KEY.
LLM_ENABLED=false
LLM_PROVIDER=          # set to "gemini" to enable
LLM_API_KEY=           # generic fallback key
LLM_MODEL=             # generic fallback model
LLM_TIMEOUT_SECONDS=8

# Gemini provider (used when LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Phase 4 (PROVE): minimal protection for financial action endpoints ---
# Empty by default (open, for local dev/demo). Set a real shared secret
# before exposing the API beyond localhost.
RECON_API_KEY=
RECON_RATE_LIMIT_PER_MINUTE=30

# --- Phase 5: Identity + RBAC ---
DEFAULT_ORGANIZATION_NAME=RECON Demo Organization
SESSION_EXPIRY_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=30
SESSION_COOKIE_SECURE=false          # set true once served over HTTPS
# Local-dev-only deterministic login — never enable in production. Creates
# ONE real user with a properly hashed password; still has to log in normally.
RECON_DEV_SEED_ADMIN=false
RECON_DEV_ADMIN_EMAIL=admin@recon.test
RECON_DEV_ADMIN_PASSWORD=

# --- Phase 5: Recovery Communications ---
# "fake" (default — safe for dev/test, never claims real delivery) or "real".
RECON_COMMUNICATIONS_MODE=fake
COMMUNICATION_RATE_LIMIT_PER_CASE_PER_DAY=5
# Real email — stdlib smtplib, no SDK dependency.
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_SSL=false          # true for implicit-TLS providers (commonly port 465)
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
# Real SMS/WhatsApp — generic HTTP webhook (no vendor SDK in this phase).
SMS_PROVIDER_WEBHOOK_URL=
SMS_PROVIDER_API_KEY=
WHATSAPP_PROVIDER_WEBHOOK_URL=
WHATSAPP_PROVIDER_API_KEY=
# Most real WhatsApp Business API providers require a pre-approved template
# name instead of freeform text. "MESSAGE_TYPE=template_name,..." — e.g.
# PAYMENT_LINK_CREATED=payment_link_v1,RECOVERY_REMINDER=reminder_v1
WHATSAPP_REQUIRE_TEMPLATE=true
WHATSAPP_TEMPLATE_IDS=

# --- Phase 7: controlled automatic recovery communication ---
# Off by default — RECON never contacts a customer automatically unless this
# is explicitly enabled. Every automatic send still goes through the same
# Policy Engine / approval / opt-out / contact-availability checks a manual
# send uses.
AUTOMATIC_COMMUNICATIONS_ENABLED=false
MAX_COMMUNICATIONS_PER_CASE=10
MAX_COMMUNICATIONS_PER_CUSTOMER_PER_DAY=5
MIN_HOURS_BETWEEN_MESSAGES=12

# --- Phase 7: provider delivery-status webhooks ---
# POST /api/v1/webhooks/communications/delivery — rejected unless signed
# (HMAC-SHA256, X-RECON-Comm-Signature header) unless explicitly opted into
# unsigned acceptance for local dev.
COMMUNICATION_WEBHOOK_SECRET=
COMMUNICATION_ALLOW_UNSIGNED_WEBHOOKS=false

# --- Phase 7: password reset ---
# Used only to build the reset link embedded in the reset email.
FRONTEND_BASE_URL=http://localhost:3000
PASSWORD_RESET_RATE_LIMIT_PER_HOUR=5

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
