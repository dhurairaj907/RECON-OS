# ============================================================
# RECON OS — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ============================================================

# --- Razorpay Test Mode Credentials ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# --- Phase 3 (ACT): Razorpay outbound (Payment Links) ---
# TEST MODE ONLY. When false, action execution is refused (no accidental live
# transactions). Key id must be rzp_test_*. Credentials are server-side only —
# never NEXT_PUBLIC_*, never in a response / log / DB row. Missing credentials
# do NOT crash the app: action execution returns RAZORPAY_NOT_CONFIGURED.
RAZORPAY_TEST_MODE=true
RAZORPAY_TIMEOUT_SECONDS=10

# Inbound webhooks are REJECTED unless they carry a valid HMAC-SHA256 signature
# verified against RAZORPAY_WEBHOOK_SECRET (set it to the secret you register in
# the Razorpay dashboard). Set the flag below true ONLY for local dev with no
# webhook secret — it accepts unsigned webhooks and must never be used elsewhere.
RAZORPAY_ALLOW_UNSIGNED_WEBHOOKS=false

# The simulator is a demo helper, NOT part of the real recovery path. Off by
# default. When true, every record/audit entry it creates is marked simulated=true
# and its "recovered" revenue is excluded from real metrics.
RECON_SIMULATOR_ENABLED=false

# --- Database ---
DATABASE_URL=postgresql://recon:recon_secret@localhost:5432/reconos

# --- Application ---
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]
DEFAULT_MERCHANT_NAME=RECON Demo Merchant

# --- Phase 2 (THINK): Intelligence pipeline ---
# When true, a new recovery case is analysed automatically after the Phase 1
# transaction commits (isolated transaction). The manual analyze endpoint
# (POST /api/v1/recovery-cases/{id}/intelligence:analyze) works either way.
INTELLIGENCE_ENABLED=false

# Policy Engine constants (deterministic, authoritative)
POLICY_MAX_RECOVERY_ATTEMPTS=3
POLICY_CONTACT_WINDOW_HOURS=24
POLICY_MAX_CONTACTS_PER_WINDOW=1
POLICY_AUTO_APPROVAL_AMOUNT_LIMIT=5000

# --- Phase 2.5 (REAL AI): optional LLM-assisted diagnosis ---
# The system is fully functional with LLM_ENABLED=false (deterministic core is
# the baseline AND the fallback). An LLM only assists diagnosis / explanation —
# never prediction, policy, financial authorisation, or Razorpay.
# Secrets are server-side ONLY. NEVER use NEXT_PUBLIC_GEMINI_API_KEY.
LLM_ENABLED=false
LLM_PROVIDER=          # set to "gemini" to enable
LLM_API_KEY=           # generic fallback key
LLM_MODEL=             # generic fallback model
LLM_TIMEOUT_SECONDS=8

# Gemini provider (used when LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
