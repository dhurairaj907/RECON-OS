# RECON OS — frontend Docker build context exclusions
# Keeps the image lean and prevents local-only files from ever being baked
# into a built image. NEXT_PUBLIC_API_URL is supplied via a Docker build ARG
# (see apps/web/Dockerfile) — a stray local .env.local must never silently
# shadow it, so it's excluded here too.

# Dependencies — reinstalled fresh via `npm ci` in the image; a host
# node_modules can carry incompatible native binaries or stale packages.
node_modules/

# Build output — regenerated by `npm run build` in the image; never copy a
# stale local build over the fresh one.
.next/
out/
tsconfig.tsbuildinfo

# Local environment files — the real API URL comes from the Dockerfile's
# NEXT_PUBLIC_API_URL build ARG, never a copied .env file.
.env
.env.local
.env.*.local

# VCS / editor / OS
.git/
.gitignore
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Test / coverage artifacts
coverage/
